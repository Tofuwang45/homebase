# Model access through Vercel AI Gateway: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Optional: an AI Gateway model id, or ollama:<model> for a local model (no API key)
HOMEBASE_MODEL=

# Home Assistant: URL and a long-lived token from a dedicated, non-admin user
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Comma-separated entity ids homebase may read or control
HOMEBASE_ENTITIES=light.kitchen,light.living_room,lock.front_door,cover.driveway_gate,binary_sensor.porch_motion
# Unlocking needs approval every time; leave false to disable it entirely
HOMEBASE_ALLOW_UNLOCK=false

# Google Calendar: shared calendar id and household time zone
HOMEBASE_CALENDAR_ID=primary
HOMEBASE_TIMEZONE=America/Los_Angeles
# Vercel Connect connector for Google (default google/homebase), or a static token for local testing
HOMEBASE_GOOGLE_CONNECTOR=
GOOGLE_CALENDAR_TOKEN=

# Slack: bot token and signing secret from https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack user ids of household members, comma-separated
HOMEBASE_MEMBERS=
# Channel for the morning brief and night check
HOMEBASE_SLACK_CHANNEL_ID=
